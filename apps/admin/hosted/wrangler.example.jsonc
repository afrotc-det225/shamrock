{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "shamrock-admin-staging",
  "main": "../../../.build/admin/hosted-worker.mjs",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH_STORE", "class_name": "StagingPanelStore" }],
  },
  "migrations": [{ "tag": "auth-store-v1", "new_sqlite_classes": ["StagingPanelStore"] }],
  "services": [{ "binding": "BACKEND", "service": "shamrock-staging" }],
  "vars": {
    "ENVIRONMENT": "staging",
    "STAGING_DATASET": "fictional",
    "APP_ORIGIN": "https://shamrock-admin-staging.det225.workers.dev",
    "BACKEND_ORIGIN": "https://shamrock-staging.det225.workers.dev",
    "GENERATION": "1",
    "AUTH_STORE_VERSION": "1",
    "SOURCE_KIND": "test",
    "SOURCE_RESOURCE": "admin-staging-web",
    "BRIDGE_KEY_ID": "REPLACE_WITH_STAGING_KEY_ID",
  },
  // Secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BRIDGE_SECRET.
  // AUTH_STORE_BOOTSTRAP is a one-time private reviewed seed. See README.md.
  // Retain the old panel D1 database privately as migration evidence; do not bind it here.
  // Never log callback URLs/codes, request bodies, cookies, or token claims.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "triggers": { "crons": ["17 * * * *"] },
}
