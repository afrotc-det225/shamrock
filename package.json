{
  "name": "shamrock",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.cjs",
    "create": "clasp create --title \"SHAMROCK\" --type standalone --rootDir dist",
    "push": "npm run build && cp appsscript.json dist/appsscript.json && clasp push",
    "pull": "clasp pull && cp dist/appsscript.json appsscript.json",
    "status": "clasp status",
    "clean": "rm -rf dist",
    "upgrade": "npx npm-check-updates -u",
    "build:v3": "node scripts/build-v3.mjs",
    "test:v3": "npm run build:v3 && node --test tests/v3/*.test.mjs",
    "check": "npm run build && npm test && npm run test:v3",
    "demo:v3": "npm run build:v3 && node scripts/demo-v3.mjs",
    "capacity:v3": "npm run build:v3 && node scripts/check-v3-capacity.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrotc-det225/shamrock.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/afrotc-det225/shamrock/issues"
  },
  "homepage": "https://github.com/afrotc-det225/shamrock#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/google-apps-script": "^2.0.8",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "npm-check-updates": "^19.6.5",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260730.1": true
  }
}
